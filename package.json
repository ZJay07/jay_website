{
  "name": "jay_website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prebuild": "npm run type-check && npm run lint",
    "type-check": "tsc --noEmit",
    "format:check": "prettier --check --end-of-line auto app components lib utils *.ts *.mjs",
    "jlint": "jlint --strict --max-line-length 88 app components lib utils",
    "fix": "next lint --fix && jlint --fix --max-line-length 88 app components lib utils && prettier --write --end-of-line auto app components lib utils *.ts *.mjs",
    "check": "npm run lint && npm run format:check && npm run jlint && npm run type-check",
    "push": "bash scripts/push.sh"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.0",
    "lucide-react": "^0.471.1",
    "next": "14.2.16",
    "next-themes": "^0.4.4",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "20.17.50",
    "@types/react": "18.3.23",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.16",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.4",
    "postcss": "^8",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.1",
    "typescript": "5.8.3"
  }
}
